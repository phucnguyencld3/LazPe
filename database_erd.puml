@startuml
hide circle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 50
entity "Address" as Address {
  AddressID : int <<PK>>
  UserID : string <<FK>>
  RecipientName : string 
  PhoneNumber : string 
  Province : string 
  District : string 
  Ward : string 
  DetailAddress : string 
  IsDefault : bool 
  CreatedAt : DateTime 
}

entity "ApplicationUser" as ApplicationUser {
  FullName : string 
  DateOfBirth : DateTime? 
  Avatar : string? 
  Status : bool 
  RegisterDate : DateTime 
  ReceiveEmailNotifications : bool 
  ReceiveOrderUpdates : bool 
  ReceivePromotions : bool 
  MomFavoriteColors : string? 
  ChildGender : string? 
  ChildAgeMonths : int? 
  ChildWeightKg : double? 
  IsOnboarded : bool 
  RefreshToken : string? 
  RefreshTokenExpiryTime : DateTime? 
  RoleTemplateId : int? <<FK>>
}

entity "Bundle" as Bundle {
  BundleID : int <<PK>>
  Name : string 
  Code : string? 
  Description : string? 
  Price : decimal? 
  OriginalPrice : decimal? 
  DiscountPercent : decimal 
  ImageUrl : string? 
  Status : bool 
  CreatedDate : DateTime 
  UpdatedDate : DateTime? 
  CreatedBy : string? 
  UpdatedBy : string? 
}

entity "BundleItem" as BundleItem {
  BundleItemID : int <<PK>>
  BundleID : int <<FK>>
  VariantID : int <<FK>>
  Quantity : int 
  SortOrder : int 
}

entity "Cart" as Cart {
  CartID : int <<PK>>
  UserID : string <<FK>>
  VoucherID : int? <<FK>>
  ShippingVoucherID : int? <<FK>>
  CreatedDate : DateTime 
  SubTotal : decimal 
  DiscountAmount : decimal 
  TierDiscountAmount : decimal 
  ShippingDiscountAmount : decimal 
  TotalAmount : decimal 
  Status : bool 
  ShippingVoucher : Voucher? 
}

entity "CartDetail" as CartDetail {
  CartDetailID : int <<PK>>
  CartID : int <<FK>>
  VariantID : int? <<FK>>
  BundleID : int? <<FK>>
  Quantity : int 
  UnitPrice : decimal 
  TotalPrice : decimal 
  IsGift : bool 
}

entity "Categories" as Categories {
  CategoryID : int <<FK>>
  CategoryName : string 
  ParentID : int? <<FK>>
  Level : int 
  SortOrder : string 
  Description : string 
  CreatedAt : DateTime 
  CreatedBy : string 
  Status : bool 
}

entity "ChatMessage" as ChatMessage {
  Id : int <<PK>>
  ChatSessionId : string <<FK>>
  SenderId : string? <<FK>>
  SenderName : string 
  IsFromAdmin : bool 
  MessageText : string? 
  ImageUrl : string? 
  CreatedAt : DateTime 
  Sender : ApplicationUser? 
}

entity "ChatSession" as ChatSession {
  Id : string <<PK>>
  UserId : string? <<FK>>
  CustomerName : string 
  CreatedAt : DateTime 
  UpdatedAt : DateTime 
  IsClosed : bool 
  LastMessageText : string? 
  UnreadByAdmin : int 
  UnreadByCustomer : int 
  AdminId : string? <<FK>>
  AdminName : string? 
  Admin : ApplicationUser? 
}

entity "District" as District {
  DistrictID : int <<PK>>
  Name : string 
  Code : string 
  ProvinceID : int <<FK>>
  IsActive : bool 
  ReplacedByCode : string? 
  Note : string? 
  ApiVersion : string 
}

entity "FlashSale" as FlashSale {
  Id : int <<PK>>
  Name : string 
  StartTime : DateTime 
  EndTime : DateTime 
  BannerUrl : string? 
  Description : string? 
  IsActive : bool 
  CreatedAt : DateTime 
  CreatedBy : string? 
}

entity "FlashSaleItem" as FlashSaleItem {
  Id : int <<PK>>
  FlashSaleId : int <<FK>>
  ReferenceId : int <<FK>>
  DiscountPrice : decimal 
  RequiredQuantity : int 
  GiftVariantIds : string? 
  TotalQuantity : int 
  SoldQuantity : int 
  MaxQuantityPerUser : int 
}

entity "Invoice" as Invoice {
  InvoiceID : int <<PK>>
