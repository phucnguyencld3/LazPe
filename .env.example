# ==========================================
# Cấu hình biến môi trường cho LazPe Docker
# ==========================================

# 1. Cấu hình Cơ sở dữ liệu SQL Server
MSSQL_SA_PASSWORD=YourSecurePassword123!
DB_CONNECTION_STRING=Server=db,1433;Database=LazPeDB;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=True;

# 2. Cấu hình Backend (.NET API)
ASPNETCORE_ENVIRONMENT=Development

# 3. Cấu hình Frontend (Next.js)
# URL của API Backend được gọi từ trình duyệt Client
NEXT_PUBLIC_API_URL=http://localhost:5101/api
PORT=3000
