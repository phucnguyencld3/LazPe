# ============================================================
#  ROOT .gitignore — .NET Backend + Next.js / Tailwind / TS
# ============================================================

# ─────────────────── OS & Editor ───────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.lnk
.Spotlight-V100
.Trashes

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# ─────────────────── .NET / ASP.NET Core ───────────────────
**/bin/
**/obj/
**/out/

*.user
*.suo
*.vs/

# Publish output
**/publish/
**/PublishProfiles/

# NuGet
*.nupkg
*.snupkg
**/.nuget/
**/packages/
!**/packages/build/
nuget.config.local

# Secrets & config overrides
**/appsettings.*.json
!**/appsettings.json
!**/appsettings.Development.json
**/secrets.json
**/*.pfx
**/*.p12
**/*.key

# Entity Framework
# **/Migrations/*.Designer.cs
# (nếu muốn commit migration thì xóa dòng trên)

# Test results
**/TestResults/
**/coverage/
**/*.coveragexml
**/*.trx

# ─────────────────── Node / Next.js / TypeScript ───────────
**/node_modules/
**/.next/
**/out/
**/.turbo/
**/.vercel/
**/.swc/

# Build output
**/dist/
**/build/

# Type-check cache
**/tsconfig.tsbuildinfo
**/*.tsbuildinfo

# ─────────────────── Environment & Secrets ─────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─────────────────── Logs ──────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ─────────────────── Package managers ──────────────────────
# Chỉ commit lockfile của 1 package manager — xóa 2 dòng kia
# yarn.lock
# pnpm-lock.yaml
# package-lock.json

# ─────────────────── Misc ──────────────────────────────────
*.cache
.eslintcache
.stylelintcache
.parcelcache
.DS_Store
/mockups/
/Local/
/JwtGen/
**/RecommendationModel.zip
**/TrendModel.zip
.env
backend/wwwroot/uploads/
backend/TrendModel.zip
