  UserID nvarchar_450 [not null]
  VoucherID int [not null]
}

Table Wards {
  WardID int [pk, not null, increment]
  ApiVersion nvarchar_10 [not null]
  Code nvarchar_20 [not null]
  DistrictID int [not null]
  IsActive bit [not null]
  Name nvarchar_100 [not null]
  Note nvarchar_max
  ReplacedByCode nvarchar_20
}

Table Wishlists {
  ProductID int [pk, not null]
  UserID nvarchar_450 [pk, not null]
  CreatedAt datetime2 [not null]
}

Table WithdrawRequests {
  RequestID int [pk, not null, increment]
  AdminNote nvarchar_500
  Amount decimal_18_2 [not null]
  BankAccount nvarchar_50 [not null]
  BankName nvarchar_100 [not null]
  BankOwnerName nvarchar_100 [not null]
  CreatedAt datetime2 [not null]
  ProcessedAt datetime2
  Status nvarchar_50 [not null]
  UserID nvarchar_450 [not null]
}

